<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DejaVu.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Platforms>x64</Platforms>
    <Platform>x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Tests.cs" />
    <!-- The production sources under test, compiled in directly rather than duplicated. -->
    <Compile Include="..\..\src\DejaVu\Native.cs" />
    <Compile Include="..\..\src\DejaVu\HotkeyBinding.cs" />
    <Compile Include="..\..\src\DejaVu\AppInfo.cs" />
    <Compile Include="..\..\src\DejaVu\AppConfig.cs" />
    <Compile Include="..\..\src\DejaVu\ReplayBuffer.cs" />
    <Compile Include="..\..\src\DejaVu\SourceApp.cs" />
    <Compile Include="..\..\src\DejaVu\MfInterop.cs" />
    <Compile Include="..\..\src\DejaVu\AudioLoopback.cs" />
    <Compile Include="..\..\src\DejaVu\CaptureEngine.cs" />
    <Compile Include="..\..\src\DejaVu\Mp4Concat.cs" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

</Project>
